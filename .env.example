# Copy to .env and fill in. Never commit the filled-in file.
# The scripts read these from the environment only -- there is nothing to edit in the source.

# https://huggingface.co/settings/tokens
# Needs gated access to CohereLabs/cohere-transcribe-arabic-07-2026 and UBC-NLP/Casablanca.
# A write-scoped token is required for vc_augment.py --push-to-hub.
HF_TOKEN=

# https://wandb.ai/authorize
# Required by cohere_train_v5.py unless you pass --no-wandb.
WANDB_API_KEY=
